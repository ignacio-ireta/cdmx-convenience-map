# Copy to .env for local overrides. .env is gitignored; .env.example is committed.
# The pipeline is configured primarily through data/config/places.json and
# data/cities/<city>/city.json — these variables only override runtime behavior.

# Logging verbosity for the cdmxmap CLI: debug | info | warning | error
CDMXMAP_LOG_LEVEL=info

# Website embed sync (used by scripts/sync_website_embed.sh and CI).
# These mirror the defaults in .github/workflows/deploy.yml.
WEBSITE_REPO=ignacio-ireta/ignacio-ireta.github.io
WEBSITE_BRANCH=master
WEBSITE_PATH=projects/cdmx-map

# NOTE: WEBSITE_REPO_DEPLOY_KEY is a deploy key and MUST live in CI secrets only.
# Never place private keys or tokens in a committed file.
