.DS_Store
.venv/
__pycache__/
*.pyc
node_modules/
dist/
dist-ssr/
logs/
*.log
.env
.env.*
!.env.example

# Downloaded/generated data can be recreated by the scripts, except the small
# seed/config CSVs that make the demo deterministic.
data/raw/*.json
data/raw/*.geojson
data/raw/*.zip
data/raw/*.csv
data/raw/*.pbf
data/raw/gtfs/
data/raw/osm/
data/archive/**
data/processed/
data/processed/*.csv
data/processed/*.geojson
data/processed/*.json
!data/raw/workplaces.csv
!data/seeds/*.csv
!data/archive/README.md
.venv-routing/

# Offline road-routing build artifacts (regenerated; never committed). The
# data/processed/ rule above already covers these; listed explicitly as guards.
# The published matrix assets live under frontend/public/data/ and ARE committed.
data/processed/routing_cache/
data/processed/valhalla/
*.pbf
valhalla_tiles/
valhalla_tiles.tar

# Python tooling caches & pipeline run artifacts
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
runs/
